            "url": {
              "raw": "{{baseUrl}}/api/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings"]
            }
          }
        },
        {
          "name": "Update setting",
          "request": {
            "method": "PATCH",
            "header": [
              {
