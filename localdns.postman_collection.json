              "path": ["api", "certs", "1"]
            }
          }
        },
        {
          "name": "Delete cert for domain",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/certs/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "certs", "1"]
            }
          }
        }
