    },
    {
      "name": "Logs",
      "item": [
        {
          "name": "Get query log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/log?limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "log"],
              "query": [
                {
                  "key": "limit",
                  "value": "200"
                }
              ]
            }
          }
        },
        {
          "name": "Clear query log",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/log",
              "host": ["{{baseUrl}}"],
              "path": ["api", "log"]
            }
          }
        }
