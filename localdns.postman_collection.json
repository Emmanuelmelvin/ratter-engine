    {
      "key": "wsUrl",
      "value": "ws://localhost:4323"
    }
  ],
  "item": [
    {
      "name": "Domains",
      "item": [
        {
          "name": "List domains",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/domains",
              "host": ["{{baseUrl}}"],
              "path": ["api", "domains"]
            }
          }
        },
        {
          "name": "Create domain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"myapp.localhost\",\n  \"type\": \"subdomain\",\n  \"target_ip\": \"127.0.0.1\",\n  \"port\": 3000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/domains",
              "host": ["{{baseUrl}}"],
              "path": ["api", "domains"]
            }
          }
        },
        {
          "name": "Update domain",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_ip\": \"127.0.0.1\",\n  \"port\": 4000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/domains/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "domains", "1"]
            }
          }
        },
        {
          "name": "Delete domain",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/domains/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "domains", "1"]
            }
          }
        },
        {
          "name": "Toggle domain",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/domains/1/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "domains", "1", "toggle"]
            }
          }
        }
      ]
    },
