{
  "info": {
    "_postman_id": "4f6d2e4e-2d7d-4c25-a2e5-4e6d0c59ad01",
    "name": "LocalDNS API",
    "description": "Postman collection for the LocalDNS backend API and WebSocket log stream.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4322"
